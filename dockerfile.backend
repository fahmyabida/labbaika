# Build context is the repo root (see docker-compose.yaml), so every source
# path here is prefixed with backend/.
FROM golang:1.22-alpine AS builder

WORKDIR /app

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./

# Static binary: the alpine runtime stage has no libc to link against.
RUN CGO_ENABLED=0 go build -o labbaika ./cmd/

FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=builder /app/labbaika .

# Exec form takes one argv element per token. The old single-string version
# looked for a binary literally named "labbaika payslip-svc".
CMD ["./labbaika", "cashbook-svc"]
